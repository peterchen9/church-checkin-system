server {
    listen 192.168.16.240:8022;
    server_name 192.168.16.240;
    root /home/peterchen/church_checkin;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }
    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/var/run/php/php8.1-fpm.sock;
        add_header X-Frame-Options "SAMEORIGIN";
        add_header X-Content-Type-Options "nosniff";
    }
    location ~ /\. {
        deny all;
    }
}
server {
    listen 192.168.16.240:8033;
    server_name 192.168.16.240;
    root /home/peterchen/church_checkin;
    index admin.html;

    location / {
        try_files $uri $uri/ =404;
    }
    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/var/run/php/php8.1-fpm.sock;
        add_header X-Frame-Options "SAMEORIGIN";
        add_header X-Content-Type-Options "nosniff";
    }
    location ~ /\. {
        deny all;
    }
}
